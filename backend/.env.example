PORT=3001
HOST=127.0.0.1
CLIENT_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://localhost:4173
# Local replica set (keep existing data unchanged)
MONGODB_URI=mongodb://127.0.0.1:27018/mygovguide_phase2?directConnection=true
MONGODB_TEST_URI=mongodb://127.0.0.1:27018/mygovguide_phase2_test?directConnection=true
# Optional process-only SRV DNS override, e.g. 1.1.1.1,8.8.8.8; blank uses system DNS.
MONGODB_DNS_SERVERS=
# Atlas alternative: replace placeholders privately in backend/.env
# MONGODB_URI=mongodb+srv://<username>:<url-encoded-password>@<cluster>/mygovguide_dev
# MONGODB_TEST_URI=mongodb+srv://<username>:<url-encoded-password>@<cluster>/mygovguide_phase2_test
# Admin login credentials: configure privately in backend/.env
ADMIN_USERNAME=
ADMIN_PASSWORD=
ENABLE_LIVE_COLLECTION=false
PHASE1_DATA_DIR=./research/phase1
SOURCE_APPROVAL_FILE=./config/source-approvals.json
HTTP_TIMEOUT_MS=10000
HTTP_MAX_BYTES=5242880

# AI preparation: configure credentials privately; no model/entitlement is assumed.
GEMINI_API_KEY_PRIMARY=
GEMINI_API_KEY_SECONDARY=
GEMINI_MODEL=
GEMINI_FREE_TIER_CONFIRMED=false
GEMINI_SECONDARY_AUTHORIZED=false
AI_PAID_USE_APPROVED=false
AI_MAX_COST_PER_DAY=0
AI_MAX_RETRIES=2
AI_MAX_CONCURRENT_JOBS=2
GEMINI_INPUT_COST_PER_MILLION=0
GEMINI_OUTPUT_COST_PER_MILLION=0
