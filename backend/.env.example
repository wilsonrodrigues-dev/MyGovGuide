# Documentation only. Runtime reads ignored backend/.env, never this file.
PORT=3001
HOST=127.0.0.1
CLIENT_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:4173
MONGODB_URI=mongodb://127.0.0.1:27018/?directConnection=true
MONGODB_DB_NAME=mygovguide_demo_v2
LEGACY_MONGODB_DB_NAME=mygovguide_dev
DENY_LEGACY_DB_WRITES=true
MONGODB_TEST_URI=mongodb://127.0.0.1:27018/mygovguide_phase2_test?directConnection=true
MONGODB_DNS_SERVERS=
ADMIN_USERNAME=
ADMIN_PASSWORD=
ENABLE_LIVE_COLLECTION=false
GEMINI_API_KEY_PRIMARY=
GEMINI_API_KEY_SECONDARY=
GEMINI_MODEL=
GEMINI_FREE_TIER_CONFIRMED=false
GEMINI_SECONDARY_AUTHORIZED=false
# shared/unknown fail closed for project quota; independent requires evidence.
GEMINI_SECONDARY_PROJECT_RELATION=shared
# Owner-supplied spelling supported. Correct alias, if supplied, takes priority.
GROQ_API_KEY_PRIMART=
GROQ_API_KEY_PRIMARY=
GROQ_MODEL=openai/gpt-oss-120b
# Confirm the actual account plan before enabling. Availability is not free entitlement.
GROQ_FREE_TIER_CONFIRMED=false
AI_PAID_USE_APPROVED=false
AI_MAX_COST_PER_DAY=0
AI_MAX_RETRIES=2
AI_MAX_CONCURRENT_JOBS=2
# Server private_ key only; use PRIVATE_KEY alias if API value is ambiguous.
IMAGEKIT_API=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
IMAGEKIT_UPLOADS_ENABLED=false
IMAGEKIT_FREE_TIER_CONFIRMED=false
# Optional bounded official-domain discovery; never enable without free entitlement.
TAVILY_API_KEY=
TAVILY_ENABLED=false
TAVILY_FREE_TIER_CONFIRMED=false
# Read-only rollback prevents application writes; use a read-only Atlas role too.
DATABASE_READ_ONLY=false
