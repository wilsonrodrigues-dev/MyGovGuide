{
  "name": "@mygovguide/backend",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "node --test tests/*.test.js",
    "test:integration": "node --test tests/integration/*.test.js",
    "import:phase1": "node scripts/cli.js import",
    "import:available": "node scripts/cli.js import-available",
    "collect:fixtures": "node scripts/cli.js fixtures",
    "collect:dry-run": "node scripts/cli.js dry-run",
    "collect:approved": "node scripts/cli.js approved",
    "audit:data": "node scripts/cli.js audit",
    "report:phase2": "node scripts/reportPhase2.js",
    "db:check": "node scripts/cli.js db",
    "db:local": "node scripts/localMongo.js",
    "registry:validate": "node scripts/cli.js registry",
    "reviews": "node scripts/cli.js reviews",
    "runs": "node scripts/cli.js runs",
    "changes": "node scripts/cli.js changes",
    "worker": "node scripts/worker.js",
    "admin:bootstrap": "node scripts/bootstrapAdmin.js",
    "db:inspect": "node scripts/inspectDatabase.js",
    "ai:check": "node scripts/providerCheck.js",
    "ai:validate": "node scripts/validateGemini.js",
    "db:migrate:content": "node scripts/migrateContent.js",
    "db:migrate:identities": "node scripts/migrateSchemeIdentity.js",
    "reviews:prepare": "node scripts/reviewEvidence.js",
    "reviews:triage": "node scripts/reviewEvidence.js --handle-safe"
  },
  "dependencies": {
    "@google/genai": "3.4.0",
    "@tesseract.js-data/eng": "1.0.0",
    "cheerio": "1.1.2",
    "cors": "2.8.6",
    "cron-parser": "^5.10.6",
    "csv-parse": "7.0.3",
    "dotenv": "17.2.3",
    "express": "5.1.0",
    "express-rate-limit": "8.7.4",
    "helmet": "8.1.0",
    "ipaddr.js": "2.2.0",
    "mongoose": "8.24.10",
    "pdf-parse": "2.4.5",
    "rss-parser": "3.13.0",
    "socket.io": "4.8.1",
    "tesseract.js": "7.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "socket.io-client": "4.8.1"
  }
}
