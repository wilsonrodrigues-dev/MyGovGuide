{
  "name": "mygovguide",
  "version": "3.0.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev -w frontend",
    "dev:backend": "npm run dev -w backend",
    "dev:frontend": "npm run dev -w frontend",
    "build": "npm run build -w frontend",
    "test:frontend": "npm test -w frontend",
    "test:backend": "npm test -w backend",
    "test:e2e": "npm run test:e2e -w frontend",
    "start": "npm start -w backend",
    "test": "npm test -w backend && npm test -w frontend",
    "test:integration": "npm run test:integration -w backend",
    "import:phase1": "npm run import:phase1 -w backend",
    "import:available": "npm run import:available -w backend",
    "collect:fixtures": "npm run collect:fixtures -w backend",
    "collect:dry-run": "npm run collect:dry-run -w backend",
    "collect:approved": "npm run collect:approved -w backend",
    "audit:data": "npm run audit:data -w backend",
    "report:phase2": "npm run report:phase2 -w backend",
    "db:check": "npm run db:check -w backend",
    "db:local": "npm run db:local -w backend",
    "registry:validate": "npm run registry:validate -w backend",
    "reviews": "npm run reviews -w backend",
    "runs": "npm run runs -w backend",
    "changes": "npm run changes -w backend",
    "worker": "npm run worker -w backend",
    "admin:bootstrap": "npm run admin:bootstrap -w backend",
    "db:inspect": "npm run db:inspect -w backend",
    "ai:check": "npm run ai:check -w backend",
    "ai:validate": "npm run ai:validate -w backend",
    "db:migrate:content": "npm run db:migrate:content -w backend"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  }
}
